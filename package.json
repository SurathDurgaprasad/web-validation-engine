{
  "name": "web-validation-engine",
  "version": "2.0.0",
  "description": "A configurable Playwright-based web validation engine for crawling web applications and detecting broken links, redirects, invalid anchors, and soft-404 responses.",
  "main": "crawler.js",
  "license": "MIT",
  "keywords": [
    "playwright",
    "web-validation",
    "web-crawler",
    "link-checker",
    "website-testing",
    "qa-automation",
    "test-automation",
    "nodejs"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "crawl": "node crawler.js",
    "crawl:config": "node crawler.js --config=config/config.json",
    "crawl:example:eggplant": "node crawler.js --config=config/examples/eggplant-docs.historical.config.json",
    "test": "node --test"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "commander": "^13.1.0",
    "exceljs": "^4.4.0",
    "fs-extra": "^11.3.0",
    "p-limit": "^6.2.0",
    "playwright": "^1.52.0",
    "winston": "^3.17.0",
    "xml2js": "^0.6.2"
  }
}